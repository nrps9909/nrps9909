diff --git a/test-d/writable.ts b/test-d/writable.ts
index 4058576bbb5d71701b4225a35b192a00f1b456b6..4a73c2fffb5edff3f6b07995772ea80408660836 100644
--- a/test-d/writable.ts
+++ b/test-d/writable.ts
@@ -83,3 +83,30 @@ class SomeClass {
 		(this as Writable<typeof this>).field = 4;
 	}
 }
+
+// Selecting no keys must preserve readonly properties.
+declare const noWritableKeys: Writable<Foo, never>;
+// @ts-expect-error
+noWritableKeys.a = 2;
+
+// A computed key selection can legitimately be empty.
+declare const noMatchingKeys: Writable<Foo, Extract<keyof Foo, `editable${string}`>>;
+// @ts-expect-error
+noMatchingKeys.b = 'updated';
+
+// Empty selections also preserve index signatures and named properties.
+declare const noWritableIndex: Writable<{readonly [key: string]: number; readonly foo: number}, never>;
+// @ts-expect-error
+noWritableIndex.foo = 2;
+// @ts-expect-error
+noWritableIndex.bar = 2;
+
+// Optional, numeric and symbol properties keep their modifiers.
+declare const propertyKey: unique symbol;
+declare const noWritableSpecialKeys: Writable<{readonly optional?: number; readonly 7: number; readonly [propertyKey]: number}, never>;
+// @ts-expect-error
+noWritableSpecialKeys.optional = 2;
+// @ts-expect-error
+noWritableSpecialKeys[7] = 2;
+// @ts-expect-error
+noWritableSpecialKeys[propertyKey] = 2;
